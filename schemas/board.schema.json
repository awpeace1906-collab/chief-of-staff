{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cos-board/v1",
  "title": "Chief of Staff board",
  "type": "object",
  "required": [
    "schema",
    "items",
    "updatedAt"
  ],
  "properties": {
    "schema": {
      "const": "cos-board/v1"
    },
    "lastCaptureAt": {
      "type": "string",
      "format": "date-time",
      "description": "End of the window the last capture run covered"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "title",
        "direction",
        "division",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^c-[0-9]+-[a-z0-9]{4}$"
        },
        "title": {
          "type": "string",
          "description": "Imperative, under 12 words: 'Upload flu shot to My Clinical Exchange'"
        },
        "direction": {
          "enum": [
            "i-owe",
            "owed-to-me",
            "deadline",
            "household"
          ]
        },
        "division": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "A key from the owner's divisions setting (e.g. \"me\"); people's names live in the config, not here"
        },
        "counterparty": {
          "type": "string",
          "description": "Who asked, or who owes it"
        },
        "due": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO date or date-time"
        },
        "dueConfidence": {
          "enum": [
            "explicit",
            "inferred",
            "none"
          ]
        },
        "status": {
          "enum": [
            "open",
            "proposed",
            "waiting",
            "snoozed",
            "done",
            "dropped"
          ]
        },
        "snoozedUntil": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "gmail",
                "calendar",
                "granola",
                "drive",
                "digest",
                "voice",
                "manual",
                "readywhen",
                "outlook",
                "microsoft-todo"
              ]
            },
            "ref": {
              "type": "string",
              "description": "Thread id, event id, note id"
            },
            "url": {
              "type": "string"
            },
            "adapter": {
              "type": "string",
              "description": "Digest adapter id from config/digests.json, when kind is digest"
            }
          }
        },
        "notes": {
          "type": "string",
          "description": "Context needed to act. No clinical details."
        },
        "evidence": {
          "type": "string",
          "description": "What showed it was done"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "promise": {
          "type": "boolean",
          "description": "The owner promised this themselves (from sent mail or notes)"
        },
        "nudges": {
          "type": "integer",
          "minimum": 0,
          "description": "How many briefs have surfaced this item while open"
        },
        "lastSurfaced": {
          "type": [
            "string",
            "null"
          ],
          "description": "Last brief day (YYYY-MM-DD) that surfaced it"
        }
      }
    }
  }
}
